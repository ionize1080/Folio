{
  "name": "folio-pdf-studio",
  "productName": "Folio PDF Studio",
  "version": "1.2.0",
  "description": "Offline PDF editing, bookmark rules and OCR review for Windows",
  "type": "module",
  "main": "main.cjs",
  "author": "Folio contributors",
  "license": "(MIT AND AGPL-3.0-or-later)",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/test.mjs",
    "build:win": "node scripts/package-win.mjs",
    "test:ui": "node scripts/test.mjs ui",
    "test:native": "node scripts/test.mjs native",
    "test:v1": "node --test tests/*.test.mjs && python3 tests/native-v10.py && node tests/ui-v10.cjs && node tests/ui-v10-all.cjs",
    "test:v11": "node --test tests/*.test.mjs && python tests/native-v11.py && node tests/ui-v11.cjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:package": "node scripts/verify-package.mjs",
    "test:documents": "node scripts/test.mjs documents"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "electron": "44.3.0",
    "extract-zip": "2.0.1",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.63.0",
    "prettier": "^3.6.2",
    "resedit": "^2.0.3"
  },
  "dependencies": {
    "dompurify": "^3.4.15",
    "opencc-js": "^1.0.5"
  },
  "releaseChannel": "rc1-p6"
}
