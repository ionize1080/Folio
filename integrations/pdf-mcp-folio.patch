diff --git a/tests/test_folio_batch.py b/tests/test_folio_batch.py
new file mode 100644
index 0000000..68c1447
--- /dev/null
+++ b/tests/test_folio_batch.py
@@ -0,0 +1,105 @@
+import hashlib
+import importlib
+import json
+
+import pymupdf
+import pytest
+
+
+def fixture(tmp_path):
+    path = tmp_path / "source.pdf"
+    doc = pymupdf.open()
+    for i in range(4):
+        doc.new_page().insert_text((50, 80), f"Chapter {i + 1}\nSample line {i + 1}")
+    doc.set_toc([[1, "Root", 1], [2, "Child", 2]])
+    doc.save(path)
+    doc.close()
+    return path
+
+
+def test_batch_reads_paged_text_and_outline_once(tmp_path):
+    api = importlib.import_module("pdf_mcp.folio_batch")
+    source = fixture(tmp_path)
+    result = api.read_pdf_batch(
+        str(source), [{"op": "text", "pages": [1, 2], "limit": 7}, {"op": "outline", "limit": 1}]
+    )
+    assert result["results"][0]["pages"][0]["nextOffset"] == 7
+    assert result["results"][1]["total"] == 2
+    assert result["results"][1]["nextOffset"] == 1
+    json.dumps(result)
+
+
+def test_atomic_batch_preserves_source_and_rolls_back_failure(tmp_path):
+    api = importlib.import_module("pdf_mcp.folio_batch")
+    source = fixture(tmp_path)
+    original = source.read_bytes()
+    output = tmp_path / "output.pdf"
+    ops = [
+        {"op": "outline.style", "selector": {"levels": [1]}, "patch": {"bold": True}},
+        {"op": "page.rotate", "pages": [2, 3], "degrees": 90},
+        {"op": "metadata.set", "values": {"title": "Batch"}},
+    ]
+    report = api.edit_pdf_batch(str(source), str(output), ops, expected_sha256=hashlib.sha256(original).hexdigest())
+    assert report["applied"] and report["operationCount"] == 3
+    with pymupdf.open(output) as doc:
+        toc = doc.get_toc(simple=False)
+        assert toc[0][3]["bold"] is True
+        assert not toc[1][3].get("bold")
+        assert doc[1].rotation == doc[2].rotation == 90
+        assert doc.metadata["title"] == "Batch"
+    assert source.read_bytes() == original
+    failed = tmp_path / "failed.pdf"
+    with pytest.raises(ValueError):
+        api.edit_pdf_batch(str(source), str(failed), ops + [{"op": "page.rotate", "pages": [9], "degrees": 90}])
+    assert not failed.exists()
+    with pytest.raises(FileExistsError):
+        api.edit_pdf_batch(str(source), str(output), ops)
+    with pytest.raises(ValueError, match="changed"):
+        api.edit_pdf_batch(str(source), str(failed), ops, expected_sha256="0" * 64)
+
+
+def test_empty_selectors_unknown_parameters_and_dry_run(tmp_path):
+    api = importlib.import_module("pdf_mcp.folio_batch")
+    source = fixture(tmp_path)
+    output = tmp_path / "dry.pdf"
+    with pytest.raises(ValueError):
+        api.edit_pdf_batch(str(source), str(output), [{"op": "outline.style", "selector": {}, "patch": {"bold": True}}])
+    with pytest.raises(ValueError):
+        api.read_pdf_batch(str(source), [{"op": "text", "pages": [1], "limti": 10}])
+    report = api.edit_pdf_batch(
+        str(source), str(output), [{"op": "page.rotate", "pages": [1], "degrees": 90}], dry_run=True
+    )
+    assert not report["applied"] and not output.exists()
+
+
+def test_batch_schema_exposes_operation_names_and_parameter_shapes():
+    from pydantic import TypeAdapter
+
+    from pdf_mcp.folio_batch import EditOperation, ReadQuery
+
+    read = TypeAdapter(ReadQuery).json_schema()
+    assert read["properties"]["op"]["enum"] == ["info", "text", "outline", "objects", "links", "boxes"]
+    assert read["required"] == ["op"]
+    assert read["properties"]["pages"]["items"]["type"] == "integer"
+    edit = TypeAdapter(EditOperation).json_schema()
+    assert "outline.style" in edit["properties"]["op"]["enum"]
+    assert "selector" in edit["properties"] and "patch" in edit["properties"]
+
+
+def test_batch_keeps_encryption_and_reports_complete_metadata(tmp_path):
+    api = importlib.import_module("pdf_mcp.folio_batch")
+    source, output = tmp_path / "secret.pdf", tmp_path / "result.pdf"
+    with pymupdf.open(fixture(tmp_path)) as doc:
+        doc.save(source, encryption=pymupdf.PDF_ENCRYPT_AES_256, owner_pw="owner", user_pw="reader")
+    api.edit_pdf_batch(
+        str(source), str(output), [{"op": "metadata.set", "values": {"title": "Updated"}}], password="owner"
+    )
+    with pymupdf.open(output) as doc:
+        assert doc.needs_pass
+        assert doc.authenticate("reader")
+        assert doc.metadata["title"] == "Updated"
+    report = api.read_pdf_batch(
+        str(output), [{"op": "info"}, {"op": "text", "pages": [1, 2]}, {"op": "outline", "limit": 5}], password="reader"
+    )
+    assert report["results"][0]["pageCount"] == 4
+    assert len(report["results"]) == 3
