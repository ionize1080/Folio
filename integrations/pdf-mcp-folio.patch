index 0000000..6f28b22
--- /dev/null
+++ b/pdf_mcp/folio_batch.py
@@ -0,0 +1,319 @@
+"""Bounded, local batch APIs: open one PDF, perform many operations, save once."""
+
+from __future__ import annotations
+
+import hashlib
+import math
+import os
+import tempfile
+from pathlib import Path
+from typing import Literal
+
+import pymupdf
+from typing_extensions import Required, TypedDict
+
+
+class ReadQuery(TypedDict, total=False):
+    op: Required[Literal["info", "text", "outline", "objects", "links", "boxes"]]
+    pages: list[int]
+    xrefs: list[int]
+    levels: list[int]
+    offset: int
+    limit: int
+
+
+class OutlineSelector(TypedDict, total=False):
+    all: bool
+    levels: list[int]
+    indices: list[int]
+    title: str
+
+
+class OutlinePatch(TypedDict, total=False):
+    index: int
+    title: str
+    bold: bool
+    italic: bool
+    color: list[float]
+
+
+class EditOperation(TypedDict, total=False):
+    op: Required[Literal["page.rotate", "page.box", "metadata.set", "page.labels", "outline.style", "outline.patch"]]
+    pages: list[int]
+    degrees: Literal[0, 90, 180, 270]
+    box: Literal["media", "crop", "trim", "bleed", "art"]
+    rect: list[float]
+    values: dict[str, str]
+    labels: list[dict]
+    selector: OutlineSelector
+    patch: OutlinePatch
+    changes: list[OutlinePatch]
+
+
+def _hash(path):
+    with open(path, "rb") as stream:
+        return hashlib.file_digest(stream, "sha256").hexdigest()
+
+
+def _keys(value, allowed):
+    if not isinstance(value, dict) or set(value) - set(allowed):
+        raise ValueError("Unknown or invalid operation parameters")
+
+
+def _integer(value, minimum, maximum):
+    if type(value) is not int or not minimum <= value <= maximum:
+        raise ValueError(f"Expected integer {minimum}..{maximum}")
+    return value
+
+
+def _pages(value, count):
+    if not isinstance(value, list) or not 1 <= len(value) <= 100:
+        raise ValueError("Supply 1..100 explicit 1-based pages")
+    return list(dict.fromkeys(_integer(p, 1, count) for p in value))
+
+
+def _slice(items, query, maximum=500):
+    offset = _integer(query.get("offset", 0), 0, 1_000_000_000)
+    limit = _integer(query.get("limit", min(100, maximum)), 1, maximum)
+    return {
+        "total": len(items),
+        "offset": offset,
+        "items": items[offset : offset + limit],
+        "nextOffset": offset + limit if offset + limit < len(items) else None,
+    }
+
+
+def _serial(value):
+    if isinstance(value, dict):
+        return {k: _serial(v) for k, v in value.items()}
+    if isinstance(value, (list, tuple, pymupdf.Point, pymupdf.Rect, pymupdf.Quad)):
+        return [_serial(v) for v in value]
+    return value
+
+
+def read_pdf_batch(input_path: str, queries: list[ReadQuery], password: str = "") -> dict:
+    """Read up to 20 queries in one open. op=info|text|outline|objects|links|boxes.
+
+    text: pages (1-based, max 100), offset and limit (characters/page, max 8000).
+    outline: offset/limit (rows), optional levels=[1] for roots; indexed 1-based.
+    objects: xrefs (max 100), offset/limit (characters/object, max 8000).
+    links/boxes: pages. Text/object output is bounded to 32000 characters total;
+    nextOffset is per page/object. No images/base64 or model calls are returned.
+    """
+    if not isinstance(queries, list) or not 1 <= len(queries) <= 20:
+        raise ValueError("Supply 1..20 queries")
+    results, budget = [], 32000
+    with pymupdf.open(input_path) as doc:
+        if doc.needs_pass and not doc.authenticate(password):
+            raise ValueError("PDF password required")
+        for query in queries:
+            op = query.get("op")
+            if op == "info":
+                _keys(query, ["op"])
+                result = {"pageCount": len(doc), "objectCount": doc.xref_length(), "metadata": doc.metadata}
+            elif op in ("text", "objects"):
+                _keys(query, ["op", "pages" if op == "text" else "xrefs", "offset", "limit"])
+                values = _pages(query.get("pages"), len(doc)) if op == "text" else query.get("xrefs")
+                if not isinstance(values, list) or not 1 <= len(values) <= 100:
+                    raise ValueError("Supply 1..100 xrefs")
+                rows = []
+                for value in values:
+                    if budget <= 0:
+                        rows.append(
+                            {
+                                "page" if op == "text" else "xref": value,
+                                "deferred": True,
+                                "nextOffset": query.get("offset", 0),
+                            }
+                        )
+                        continue
+                    raw = (
+                        doc[value - 1].get_text()
+                        if op == "text"
+                        else doc.xref_object(_integer(value, 1, doc.xref_length() - 1), compressed=False)
+                    )
+                    part = _slice(raw, query, 8000)
+                    text = part.pop("items")[:budget]
+                    budget -= len(text)
+                    end = part["offset"] + len(text)
+                    rows.append(
+                        {
+                            "page" if op == "text" else "xref": value,
+                            **part,
+                            "text": text,
+                            "nextOffset": end if end < len(raw) else None,
+                        }
+                    )
+                result = {"pages" if op == "text" else "objects": rows}
+            elif op == "outline":
+                _keys(query, ["op", "offset", "limit", "levels"])
+                rows = [
+                    {"index": i + 1, "level": row[0], "title": row[1], "page": row[2], "destination": row[3]}
+                    for i, row in enumerate(doc.get_toc(simple=False))
+                ]
+                if "levels" in query:
+                    rows = [row for row in rows if row["level"] in query["levels"]]
+                result = _slice(rows, query)
+            elif op in ("links", "boxes"):
+                _keys(query, ["op", "pages", "offset", "limit"])
+                rows = []
+                for number in _pages(query.get("pages"), len(doc)):
+                    page = doc[number - 1]
+                    rows.append(
+                        {
+                            "page": number,
+                            **(
+                                _slice(page.get_links(), query)
+                                if op == "links"
+                                else {
+                                    "rotation": page.rotation,
+                                    "media": list(page.mediabox),
+                                    "crop": list(page.cropbox),
+                                }
+                            ),
+                        }
+                    )
+                result = {"pages": rows}
+            else:
+                raise ValueError(
+                    "Use op=info|text|outline|objects|links|boxes; example queries=[{op:info},{op:text,pages:[1,2]},{op:outline,limit:5}]"
+                )
+            results.append({"op": op, **result})
+    return _serial({"results": results, "remainingCharacterBudget": budget})
+
+
+def edit_pdf_batch(
+    input_path: str,
+    output_path: str,
+    operations: list[EditOperation],
+    expected_sha256: str = "",
+    dry_run: bool = False,
+    password: str = "",
+) -> dict:
+    """Apply <=100 local operations in memory, then atomically publish ONE new PDF.
+
+    Failures leave source/output untouched. dry_run validates without saving.
+    op=page.rotate: pages, degrees=0|90|180|270 (absolute).
+    op=page.box: pages, box=media|crop|trim|bleed|art, rect=[x0,y0,x1,y1].
+    op=metadata.set: values dictionary. op=page.labels: labels array.
+    op=outline.style: selector with explicit all=true, levels, indices (1-based),
+    or title substring; patch={bold?,italic?,color?}. Other attributes preserved.
+    op=outline.patch: changes=[{index:1,title?:...,bold?:...,italic?:...,color?:...}].
+    Coordinates use PyMuPDF top-left page space. Never re-send the entire tree.
+    """
+    if not isinstance(operations, list) or not 1 <= len(operations) <= 100:
+        raise ValueError("Supply 1..100 operations")
+    source, output = Path(input_path).resolve(), Path(output_path).resolve()
+    if source == output:
+        raise ValueError("Input overwrite is not allowed")
+    if output.exists():
+        raise FileExistsError(str(output))
+    before = _hash(source)
+    if expected_sha256 and before != expected_sha256:
+        raise ValueError("Input changed; reread before editing")
+    counts = []
+    with pymupdf.open(source) as doc:
+        if doc.needs_pass and not doc.authenticate(password):
+            raise ValueError("PDF password required")
+        for operation in operations:
+            op = operation.get("op")
+            changed = 0
+            if op in ("page.rotate", "page.box"):
+                _keys(operation, ["op", "pages", "degrees"] if op == "page.rotate" else ["op", "pages", "box", "rect"])
+                for number in _pages(operation.get("pages"), len(doc)):
+                    page = doc[number - 1]
+                    if op == "page.rotate":
+                        if operation.get("degrees") not in (0, 90, 180, 270):
+                            raise ValueError("Invalid rotation")
+                        page.set_rotation(operation["degrees"])
+                    else:
+                        box, rect = operation.get("box"), operation.get("rect")
+                        if box not in ("media", "crop", "trim", "bleed", "art"):
+                            raise ValueError("Invalid page box")
+                        if (
+                            not isinstance(rect, list)
+                            or len(rect) != 4
+                            or any(not isinstance(n, (int, float)) or not math.isfinite(n) for n in rect)
+                        ):
+                            raise ValueError("Invalid rectangle")
+                        if rect[0] >= rect[2] or rect[1] >= rect[3]:
+                            raise ValueError("Empty rectangle")
+                        getattr(page, "set_" + box + "box")(pymupdf.Rect(rect))
+                    changed += 1
+            elif op == "metadata.set":
+                _keys(operation, ["op", "values"])
+                doc.set_metadata({**doc.metadata, **operation["values"]})
+                changed = len(operation["values"])
+            elif op == "page.labels":
+                _keys(operation, ["op", "labels"])
+                doc.set_page_labels(operation["labels"])
+                changed = len(operation["labels"])
+            elif op in ("outline.style", "outline.patch"):
+                _keys(operation, ["op", "selector", "patch"] if op == "outline.style" else ["op", "changes"])
+                toc = doc.get_toc(simple=False)
+                if op == "outline.style":
+                    selector = operation.get("selector")
+                    _keys(selector, ["all", "levels", "indices", "title"])
+                    if not selector or ("all" in selector and selector["all"] is not True):
+                        raise ValueError("Explicit outline selector required")
+                    patch = operation["patch"]
+                    _keys(patch, ["bold", "italic", "color"])
+                    changes = [
+                        {"index": i + 1, **patch}
+                        for i, row in enumerate(toc)
+                        if ("levels" not in selector or row[0] in selector["levels"])
+                        and ("indices" not in selector or i + 1 in selector["indices"])
+                        and ("title" not in selector or selector["title"] in row[1])
+                    ]
+                else:
+                    changes = operation["changes"]
+                if not isinstance(changes, list) or len(changes) > 10000:
+                    raise ValueError("Too many outline changes")
+                for change in changes:
+                    _keys(change, ["index", "title", "bold", "italic", "color"])
+                    index = _integer(change.get("index"), 1, len(toc)) - 1
+                    row = toc[index]
+                    if "title" in change:
+                        if not isinstance(change["title"], str) or not change["title"].strip():
+                            raise ValueError("Invalid title")
+                        row[1] = change["title"]
+                    for key in ("bold", "italic"):
+                        if key in change:
+                            if type(change[key]) is not bool:
+                                raise ValueError("Style must be boolean")
+                            row[3][key] = change[key]
+                    if "color" in change:
+                        color = change["color"]
+                        if (
+                            not isinstance(color, list)
+                            or len(color) != 3
+                            or any(type(n) not in (int, float) or not 0 <= n <= 1 for n in color)
+                        ):
+                            raise ValueError("Color must be RGB fractions")
+                        row[3]["color"] = tuple(color)
+                    doc.set_toc_item(index, title=row[1], dest_dict=row[3])
+                    changed += 1
+            else:
+                raise ValueError("Unknown edit op")
+            counts.append({"op": op, "changed": changed})
+        report = {
+            "applied": not dry_run,
+            "operationCount": len(operations),
+            "operations": counts,
+            "sourceSha256": before,
+        }
+        if dry_run:
+            return report
+        fd, temporary = tempfile.mkstemp(prefix=".pdf-batch-", suffix=".pdf", dir=output.parent)
+        os.close(fd)
+        try:
+            doc.save(temporary, garbage=0, deflate=True, encryption=pymupdf.PDF_ENCRYPT_KEEP)
+            with pymupdf.open(temporary) as verify:
+                if len(verify) != len(doc):
+                    raise ValueError("Output validation failed")
+            if _hash(source) != before:
+                raise ValueError("Input changed during editing")
+            os.link(temporary, output)  # Atomic, and never replaces an existing file.
+        finally:
+            Path(temporary).unlink(missing_ok=True)
+    return {**report, "output": str(output), "outputSha256": _hash(output)}
